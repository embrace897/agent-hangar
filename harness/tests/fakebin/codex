#!/bin/sh
# Codex de mentira (harness/tests/subscription_check.sh): pela assinatura ChatGPT, o login vem do auth.json em
# $HOME/.codex (nunca do ambiente), sem provedor customizado; "renova" o login para a central guardar o novo.
[ "$1" = "mcp" ] && exit 0
AUTH="$HOME/.codex/auth.json"
[ -f "$AUTH" ] || { echo "sem auth.json" >&2; exit 3; }
if [ -n "${OPENAI_API_KEY:-}" ] || [ -n "${CODEX_AUTH_JSON:-}" ] || [ -n "${LLM_API_KEY:-}" ]; then
  echo "VAZOU: credencial no ambiente" >&2; exit 4
fi
case "$*" in *model_provider*) echo "provedor customizado no modo assinatura" >&2; exit 5 ;; esac
OUT=""
while [ $# -gt 0 ]; do [ "$1" = "-o" ] && OUT="$2"; shift; done
sed 's/ref-old/ref-new/' "$AUTH" > "$AUTH.tmp" && mv "$AUTH.tmp" "$AUTH"
echo "feito pelo codex" > "$OUT"
echo '{"type":"turn.completed","usage":{"input_tokens":7,"output_tokens":3}}'
