# Agent Hangar — copie para .env e preencha, ou rode scripts/setup.sh (scripts/setup.ps1 no Windows),
# que gera todos os segredos abaixo automaticamente.

# Credencial de bootstrap e emergência (poder total). Com o SSO configurado, guarde-a num cofre; no dia a dia
# cada pessoa entra com a conta da empresa e usa o próprio token pessoal (Chaves de API → user).
ADMIN_TOKEN=
# Chave Fernet que criptografa as api keys das conexões de LLM no banco. NÃO a perca: sem ela as chaves
# salvas não podem ser lidas. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HANGAR_SECRET_KEY=
# Segredo HMAC dos tokens internos por agente (agente -> hangar).
INTERNAL_SECRET=
POSTGRES_PASSWORD=

# Login corporativo (OAuth2). Também dá para configurar tudo na UI (SSO e SCIM), que tem prioridade.
# Redirect URI a cadastrar no provedor: <PUBLIC_BASE_URL>/api/auth/callback/<google|microsoft|github|oauth2>
# E-mails que viram admin da plataforma no primeiro login (vírgula):
# BOOTSTRAP_ADMIN_EMAILS=voce@empresa.com
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_ALLOWED_DOMAINS=empresa.com
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=empresa.onmicrosoft.com     # ID ou domínio do tenant (nunca "common")
# OAUTH_MICROSOFT_FETCH_GROUPS=1                     # grupos -> times (GroupMember.Read.All, consentimento de admin)
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_ORGS=sua-org                          # exige ser membro da organização
# LOCAL_LOGIN=0                                      # desliga contas locais (usuário e senha); padrão: ligado
# SESSION_TTL_HOURS=12

# Memória dos agentes (docker compose --profile memory up -d --build) — ver docs/memory.md.
# scripts/setup.* geram MEMORY_TOKEN, NEO4J_PASSWORD, FALKORDB_PASSWORD e MEM0_PG_PASSWORD.
# MEMORY_URL=http://memory:8000
# MEMORY_LLM_CONNECTION=            # nome de uma conexão de LLM (protocol openai) que extrai os fatos
# MEMORY_LLM_MODEL=                 # vazio = modelo padrão da conexão
# MEMORY_LLM_OUTPUT_MODE=json_object  # json_schema se o provedor suportar
# MEMORY_BACKEND=neo4j              # ou falkordb (profile memory-falkordb) ou mem0 (profile memory-mem0)
# MEM0_PG_URL=                      # mem0: vazio = o Postgres do profile; ou um Postgres da empresa com pgvector
# MEMORY_EMBEDDER=local             # local (fastembed, nada sai da rede) | openai (+ MEMORY_EMBEDDING_CONNECTION)
MEMORY_TOKEN=
NEO4J_PASSWORD=
FALKORDB_PASSWORD=
MEM0_PG_PASSWORD=

# Activepieces (docker compose --profile activepieces up -d) — ver docs/remote-mcp.md. scripts/setup.* geram os segredos.
ACTIVEPIECES_ENCRYPTION_KEY=
ACTIVEPIECES_JWT_SECRET=
ACTIVEPIECES_POSTGRES_PASSWORD=
# ACTIVEPIECES_PUBLIC_URL=http://localhost:8098
# ACTIVEPIECES_PORT=8098

# Catálogo Docker MCP (docker compose --profile mcp-gateway up -d) — ver docs/mcp-catalog.md
# MCP_GATEWAY_VERSION=v0.43.3
# MCP_GATEWAY_CATALOG_URL=https://desktop.docker.com/mcp/catalog/v2/catalog.yaml

# Agendamentos: o fuso padrão fica na empresa (PATCH /api/org {"timezone": "America/Sao_Paulo"}).
# SCHEDULER_ENABLED=1                                # 0 desliga o agendador (ex.: numa réplica só de API)
# SCHEDULE_MIN_INTERVAL_MIN=5                        # menor intervalo entre disparos
# SCHEDULE_ALLOW_PRIVATE_WEBHOOKS=0                  # 1 libera webhooks para a rede interna

# Decisões dos Digital employees por e-mail e resumo diário (opcional). Slack e Teams se configuram no portal.
# SMTP_HOST=smtp.empresa.com
# SMTP_PORT=587
# SMTP_USER=hangar@empresa.com
# SMTP_PASSWORD=
# SMTP_FROM=Agent Hangar <hangar@empresa.com>
# SMTP_SECURITY=starttls                             # starttls | ssl | none
# COOKIE_SECURE=1                                    # padrão: 1 quando PUBLIC_BASE_URL é https

# URL pela qual clientes (Claude, LibreChat, …) alcançam o hangar.
PUBLIC_BASE_URL=http://localhost:8090

# Observabilidade (docs/observability.md): métricas Prometheus numa porta separada, logs JSON e traces OpenTelemetry
# METRICS_PORT=9100                  # sem Prometheus: GET /api/metrics (admins e auditores)
# LOG_FORMAT=json
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# OAuth do MCP: Claude.ai, ChatGPT e outros clientes web conectam colando só <PUBLIC_BASE_URL>/mcp (exige HTTPS público);
# a pessoa entra no portal e autoriza. Os apps só podem redirecionar para estes hosts (além de localhost):
# OAUTH_ENABLED=1
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,chat.openai.com,platform.openai.com   # "*" = qualquer https
# OAUTH_ACCESS_TTL_S=3600            # validade do token de acesso
# OAUTH_REFRESH_TTL_DAYS=30          # sem uso por este tempo, a pessoa autoriza de novo
CENTRAL_PORT=8090

# Imagens: padrão = builds locais. Para usar as imagens publicadas:
# HANGAR_REGISTRY=ghcr.io/<owner>
# HANGAR_VERSION=0.1.0

# Usado só quando um agente não tem nenhuma conexão de LLM associada (mock = sem custo, sem chave).
DEFAULT_MODEL=mock/echo
JOB_TIMEOUT_S=180

# Migração de uma instalação "central-agents" (pré-0.1.0): reaproveite o volume e o usuário do Postgres.
# PGDATA_VOLUME=central-agents_pgdata
# POSTGRES_USER=central
# POSTGRES_DB=central

# Nenhum LLM roda em Docker aqui. Registre conexões (url + model_name + api key virtual — ex.: seu gateway
# LiteLLM, OpenRouter, OpenAI, Anthropic) pela UI (Provedores) ou via MCP (register_llm_connection).

# Data Studio (docker compose --profile data-studio): links de download precisam abrir no navegador dos usuários
# DATA_STUDIO_PUBLIC_URL=http://localhost:8095
# DATA_STUDIO_PORT=8095
# DATA_STUDIO_MEM=4g

# Exposição pública sem abrir portas (o `hangar setup` preenche; um por vez, via COMPOSE_PROFILES):
# COMPOSE_PROFILES=tunnel-cloudflare        # ou tunnel-ngrok | tunnel-tailscale (separe por vírgula com outros profiles)
# CLOUDFLARE_TUNNEL_TOKEN=                  # Zero Trust → Tunnels; Public Hostname -> http://central:8080
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=hangar-acme.ngrok-free.app
# TS_AUTHKEY=                               # Tailscale (habilite HTTPS + Funnel na tailnet)
# TS_HOSTNAME=agent-hangar
# Login OAuth2 genérico (Okta, Keycloak, Auth0…):
# OAUTH_OAUTH2_CLIENT_ID=
# OAUTH_OAUTH2_CLIENT_SECRET=
# OAUTH_OAUTH2_AUTHORIZE_URL=
# OAUTH_OAUTH2_TOKEN_URL=
# OAUTH_OAUTH2_USERINFO_URL=
# OAUTH_OAUTH2_LABEL=Okta
